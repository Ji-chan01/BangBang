# ─── Database (Neon Postgres) ───
# Get these from your Neon dashboard after creating a project.
# Use the POOLED connection string for runtime (Vercel Functions).
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/bangbang?sslmode=require

# Use the DIRECT (unpooled) connection string for migrations only.
# This avoids PgBouncer issues with DDL statements.
DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.region.aws.neon.tech/bangbang?sslmode=require

# ─── Vercel ───
# These are set automatically by Vercel during deployment.
# VERCEL_URL=your-project.vercel.app
# VERCEL_ENV=production|preview|development

# ─── PeerJS (optional, for multiplayer) ───
# If you self-host a PeerJS signaling server, set this.
# Otherwise, PeerJS uses its free cloud server by default.
# PEERJS_HOST=your-peerjs-server.com
# PEERJS_PORT=443
# PEERJS_PATH=/peerjs

